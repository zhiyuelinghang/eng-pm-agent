# 本地开发默认使用 SQLite；平台状态机直接访问业务数据，MCP 只能调用获授权的数据库交互。
DATABASE_URL=sqlite:///./data/engpm.db
JWT_SECRET=请替换为随机长字符串
CORS_ORIGINS=http://localhost:38429,http://127.0.0.1:38429

# OpenAI 兼容模型服务。留空时协同助手使用项目数据生成规则化建议。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# AgentScope 管理页使用独立账号登录；该账号只负责管理权限，不属于工程平台。
# AgentScope 的凭证、模型、智能体、知识库等配置统一保存在全局配置空间。
AGENTSCOPE_BASE_URL=http://127.0.0.1:18642
AGENTSCOPE_ADMIN_USERNAME=请设置独立的管理账号
AGENTSCOPE_ADMIN_PASSWORD=请设置高强度管理密码
AGENTSCOPE_AUTH_SECRET=请替换为至少32位随机签名密钥
AGENTSCOPE_SERVICE_TOKEN=请替换为至少32位随机平台服务令牌
# 可单独设置 AgentScope 调用 Dobby 工具网关的令牌；留空时复用上面的平台服务令牌。
DOBBY_AGENT_TOOL_TOKEN=
# 可选：MCP 访问平台上下文和数据库交互的内部地址；本地默认如下。
# DOBBY_AGENT_TOOL_BASE_URL=http://127.0.0.1:38430/api/internal/agent-tools
# 平台固定附件解析工具使用的 MinerU 路由；留空时使用工具包内默认地址。
MINERU_FILE_PARSE_URL=https://mgwzs689.xiaomy.net/file_parse
MINERU_BACKEND=hybrid-engine
MINERU_SERVER_URL=
MINERU_TIMEOUT_SECONDS=180
# 可选：AgentScope 访问工程平台内部管理接口的根地址；默认从工具网关地址推导。
# DOBBY_INTERNAL_API_BASE_URL=http://127.0.0.1:38430/api/internal
AGENTSCOPE_GLOBAL_CONFIG_ID=default
AGENTSCOPE_MANAGEMENT_TOKEN_TTL_SECONDS=28800
AGENTSCOPE_REQUEST_TIMEOUT_SECONDS=150
AGENTSCOPE_POLL_INTERVAL_SECONDS=0.35
# 平台 MCP 包目录默认位于 data/agentscope/mcp_registry；通常无需修改。
# 每个会话独立复用一组 MCP 进程，空闲超时后自动释放。
AGENTSCOPE_MCP_REGISTRY_HOME=./data/agentscope/mcp_registry
AGENTSCOPE_MCP_IDLE_TTL_SECONDS=3600
AGENTSCOPE_MCP_MAX_ACTIVE_INSTANCES=128

# Docker 可选服务配置
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
